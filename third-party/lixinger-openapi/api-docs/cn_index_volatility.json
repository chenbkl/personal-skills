{
  "api": "指数波动率API",
  "apiKey": "cn/index/volatility",
  "url": "https://open.lixinger.com/api/cn/index/volatility",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "stockCode",
      "required": "Yes",
      "type": "String",
      "descriptions": [],
      "constraints": [
        "请参考指数信息API获取合法的stockCode。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。",
        "用于获取一定时间范围内的数据。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
      ]
    },
    {
      "name": "endDate",
      "required": "No",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "结束信息日期。用于获取时间范围内的数据，默认值为今天结束。"
      ]
    },
    {
      "name": "volatilityDays",
      "required": "Yes",
      "type": "Number",
      "descriptions": [
        "计算波动率样本天数"
      ],
      "constraints": [
        "必须是不小于5的整数。"
      ]
    }
  ],
  "responseParams": [
    {
      "name": "date",
      "type": "Date",
      "description": "数据时间"
    },
    {
      "name": "value",
      "type": "Number",
      "description": "年化波动率"
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过时间范围获取",
      "requestBody": {
        "startDate": "2021-07-10",
        "endDate": "2026-07-10",
        "volatilityDays": 20,
        "stockCode": "000016",
        "token": "***********"
      }
    }
  ]
}